# Keep only the addon, player documentation, screenshots and packaging settings.
/*
!/.gitignore
!/.pkgmeta
!/LICENSE
!/README.md
!/Azerobics/
!/docs/

/Azerobics/**
!/Azerobics/**/
!/Azerobics/**/*.lua
!/Azerobics/**/*.toc
!/Azerobics/**/*.tga
!/Azerobics/**/*.blp
!/Azerobics/**/*.ogg
!/Azerobics/README.md
!/Azerobics/LICENSE

/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/*.png

.env
.env.*
*.zip
*.log
*.bak
*.tmp
*.pyc
__pycache__/
Thumbs.db
Desktop.ini
.DS_Store
WTF/
Cache/
SavedVariables/
